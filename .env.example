# Obbligatorio: inserire localmente il valore configurato anche in Meta.
VERIFY_TOKEN=
# Opzionale; default invariato: 3000.
PORT=3000
# Missioni iOS: credenziale distinta da VERIFY_TOKEN; nessun valore di esempio.
ARGO_API_TOKEN=
# URL PostgreSQL dell'ambiente scelto. Non è necessaria per i soli webhook.
DATABASE_URL=
# Telemetria Zenit: chiave solo server-side. Non inserirla nell'app iOS.
ZENIT_API_KEY=
# Opzionale; lasciare vuoto per https://api.zenittelematics.com.
ZENIT_API_BASE_URL=
